# Copy this file to ".env" and fill in the three values.

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID > Web application)
# Authorised redirect URI must be:  http://localhost:8765/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apify (console.apify.com > Settings > API & Integrations > Personal API token)
APIFY_TOKEN=

# Online hosting only (set these in the host's settings, not in this file)
# ALLOWED_EMAILS=you@gmail.com          only these Google accounts may sign in
# UPSTASH_REDIS_REST_URL=               where data is saved online
# UPSTASH_REDIS_REST_TOKEN=

# Optional
# SYNC_HOURS=24            how often each account is re-scraped
# FIRST_DAYS=2             new account: clips posted in the last N days
# DAILY_HOURS=30           daily check: clips posted in the last N hours
# PORT=8765
# BASE_URL=http://localhost:8765   change when you host it on a real domain
